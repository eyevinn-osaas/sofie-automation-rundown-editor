# Sofie Rundown Editor for Eyevinn Open Source Cloud.
# ---------- Build Stage ----------
FROM node:22-slim AS builder
ENV NODE_ENV=production
WORKDIR /app
RUN corepack enable && corepack prepare yarn@4.9.1 --activate
COPY . .
RUN yarn install --frozen-lockfile
RUN yarn build
RUN mkdir -p /app/data

# ---------- Runtime ----------
FROM builder
ENV NODE_ENV=production
ENV PORT=8080
EXPOSE 8080
COPY osc-seed-settings.mjs /usr/local/bin/osc-seed-settings.mjs
COPY --chmod=755 osc-entrypoint.sh /usr/local/bin/osc-entrypoint.sh
ENTRYPOINT ["/usr/local/bin/osc-entrypoint.sh"]
CMD ["yarn", "start"]
